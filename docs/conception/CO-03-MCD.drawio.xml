        <mxCell id="vXXlog83YND75pGu-ro5-33" parent="GQdLfXULcYUYypJVAUfy-1" style="text;html=1;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=14;fontColor=#203146;align=left;verticalAlign=top;spacing=0;" value="&lt;div style=&quot;margin-bottom:7px;&quot;&gt;&lt;b&gt;id_parametres&lt;/b&gt; — identifiant&lt;/div&gt;&lt;div style=&quot;margin-bottom:7px;&quot;&gt;texte_remerciement&lt;/div&gt;&lt;div style=&quot;margin-bottom:7px;&quot;&gt;taux_tva_defaut&lt;/div&gt;&lt;div style=&quot;margin-bottom:7px;&quot;&gt;&lt;i&gt;Entité isolée volontairement : configuration à occurrence unique&lt;/i&gt;&lt;/div&gt;" vertex="1">
